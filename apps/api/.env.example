# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5174
LOG_LEVEL=info

# --- Postgres (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://applyflow:applyflow@localhost:5432/applyflow?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- LLM (any OpenAI-compatible endpoint) ---
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1   (LLM_API_KEY can be any non-empty string, e.g. "ollama")
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-replace-me
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=90000

# --- Embeddings (must produce 1536-dim vectors to match vector(1536)) ---
# Leave EMBEDDING_BASE_URL / EMBEDDING_API_KEY empty to reuse the LLM_* values.
# Note: OpenRouter does not serve embeddings on all plans; point these at OpenAI or Ollama if needed.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Worker ---
WORKER_CONCURRENCY=3
JOB_MAX_ATTEMPTS=3
